# Vocalis backend configuration

# API Endpoints
OLLAMA_HOST="http://localhost:11434"  # Ollama server URL
OLLAMA_MODEL="llama3" # Default model for Ollama

# STT Model Configuration
STT_MODEL_NAME="ibm-granite/granite-speech-3.3-2b"  # Hugging Face model for STT

# TTS Configuration (Chatterbox)
TTS_DEVICE="auto" # Device for Chatterbox TTS model ("auto", "cuda", "cpu")

# WebSocket Server Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

# Audio Processing
VAD_THRESHOLD=0.1          # Voice activity detection threshold (0.0-1.0)
VAD_BUFFER_SIZE=30         # Buffer size in milliseconds
AUDIO_SAMPLE_RATE=44100    # Sample rate in Hz (Frontend sends this, STT model expects 16kHz)

# Security
# VOCALIS_API_KEY="development_secret_key" # API Key was removed from REST endpoint logic
